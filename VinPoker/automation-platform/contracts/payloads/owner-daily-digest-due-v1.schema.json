{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vbacker.internal/automation/payloads/owner-daily-digest-due-v1.schema.json",
  "title": "OwnerDailyDigestDuePayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_date",
    "window_start",
    "window_end",
    "timezone",
    "config_version",
    "schedule_key"
  ],
  "properties": {
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z_]+\\/[A-Za-z_]+(?:\\/[A-Za-z_]+)?$",
      "maxLength": 64
    },
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "schedule_key": {
      "type": "string",
      "pattern": "^owner_daily_digest:[a-f0-9-]{36}:\\d{4}-\\d{2}-\\d{2}$",
      "maxLength": 96
    }
  }
}
